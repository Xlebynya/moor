{
    "singleQuote": true,
    "trailingComma": "es5",
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 80,
    "semi": false,
    "bracketSpacing": true,
    "errorOnUnparsableFiles": false,

    "bracketSameLine": false,
    "jsxBracketSameLine": false,
    "arrowParens": "avoid",
    "proseWrap": "preserve",
    "htmlWhitespaceSensitivity": "css",
    "embeddedLanguageFormatting": "auto"
}
